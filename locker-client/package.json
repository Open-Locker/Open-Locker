{
  "name": "locker-client",
  "version": "1.0.0",
  "description": "Open Locker hexagonal MQTT/Modbus bridge",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node src/main.ts",
    "sim": "ts-node src/main-simulator.ts",
    "build": "tsc",
    "test": "pnpm run build && node --test dist/tests/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run typecheck && pnpm run format:check && pnpm run lint",
    "fallow": "fallow audit",
    "fallow:boundaries": "fallow dead-code --boundary-violations"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dotenv": "^18.0.5",
    "js-yaml": "^4.3.2",
    "modbus-serial": "^8.0.23-no-serial-port",
    "mqtt": "^5.16.0",
    "p-queue": "^9.3.3",
    "serialport": "^13.0.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fallow": "^3.31.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "fast-uri@>=3.0.0 <3.1.8": ">=3.1.8 <4.0.0",
      "ip-address@<10.7.3": ">=10.7.3 <11.0.0"
    }
  }
}
