# Locker Client v2 Configuration — mount at /config/locker-config.yml
#
# Adapter type, board variant, feedback wiring, compartment mapping, and heartbeat
# interval are server-managed via MQTT apply_config and persisted under DATA_DIR.
# No hardware adapter or channel count is selected locally.

modbus:
  port: /dev/ttyACM0
  baudRate: 9600
  dataBits: 8
  stopBits: 1
  parity: none
  timeout: 1000
  # Used only when the runtime adapter_type is waveshare_modbus.
  flashDurationMs: 200

mqtt:
  cleanSession: false
  keepaliveSeconds: 60
  reconnectPeriodMs: 5000
  connectTimeoutMs: 30000
  maxReconnectAttempts: 0
