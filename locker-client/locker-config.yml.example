# Locker Client v2 Configuration — mount at /config/locker-config.yml
#
# Adapter type, feedback wiring, compartment mapping, and heartbeat interval are
# server-managed via MQTT apply_config and persisted under DATA_DIR. No hardware
# adapter is selected locally.

# The only serial setting: the lock board fixes 9600 8N1. Prefer a stable
# /dev/serial/by-id/... path over /dev/ttyUSB0.
serial:
  port: /dev/ttyACM0

mqtt:
  cleanSession: false
  keepaliveSeconds: 60
  reconnectPeriodMs: 5000
  connectTimeoutMs: 30000
  maxReconnectAttempts: 0
