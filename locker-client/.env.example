# Locker Client — copy to .env for local development or Docker Compose:
#   cp .env.example .env
#
# In Docker, mount /config/locker-config.yml and /data (or set CONFIG_DIR / DATA_DIR).

# --- Deployment ---
# Keep `latest` for local development only. Pin an immutable `client-v*` image
# tag for beta and production deployments.
LOCKER_CLIENT_IMAGE_TAG=latest
WATCHTOWER_POLL_INTERVAL=300
DOCKER_API_VERSION=1.44
TZ=UTC

# --- First-time provisioning (required until .mqtt-credentials.json exists in DATA_DIR) ---
PROVISIONING_TOKEN=

# Bootstrap MQTT credentials (used only during provisioning; not the device credentials)
MQTT_DEFAULT_USERNAME=provisioning_client
MQTT_DEFAULT_PASSWORD=a_public_password

# --- Runtime connectivity ---
# Production requires MQTTS with a certificate trusted by the system CA store.
MQTT_BROKER_URL=mqtts://mqtt.example.com:8883

# Optional: stable MQTT client identity (defaults to generated ID in DATA_DIR)
# MQTT_CLIENT_ID=

# --- Paths (defaults match Docker layout) ---
# DATA_DIR=/data
# CONFIG_DIR=/config

# --- Logging ---
LOG_LEVEL=info

# --- Observability (opt-in) ---
# Without OTEL_EXPORTER_OTLP_ENDPOINT the client records and exports nothing,
# and never even loads the OpenTelemetry SDK. Point it at a collector and it
# ships both traces and log records; log lines also carry trace_id and span_id,
# and keep going to the console exactly as before.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Every locker reports under one service name, told apart by the locker UUID.
# OTEL_SERVICE_NAME=open-locker-client
# OTEL_SERVICE_VERSION=
# OTEL_SDK_DISABLED=false
