---
type Props = {
	videoLabel: string;
	compartments: Array<{
		label: string;
		content: string;
		video: string;
	}>;
	openLabel: string;
	openingLabel: string;
	openedLabel: string;
	closeLabel: string;
	readyStatus: string;
	openingStatus: string;
	openStatus: string;
};

const {
	videoLabel,
	compartments,
	openLabel,
	openingLabel,
	openedLabel,
	closeLabel,
	readyStatus,
	openingStatus,
	openStatus,
} = Astro.props;
---

<div
	data-locker-demo
	data-ready-status={readyStatus}
	data-opening-status={openingStatus}
	data-open-status={openStatus}
	data-open-label={openLabel}
	data-opening-label={openingLabel}
	data-opened-label={openedLabel}
>
	<div class="relative overflow-hidden bg-white">
		<div class="relative z-20 mx-auto max-w-6xl px-4 py-14 md:py-20">
			<div class="md:w-1/3 md:pr-10">
				<slot />
			</div>
		</div>

		<div class="locker-video-frame relative z-0 aspect-video w-full md:absolute md:inset-y-0 md:right-0 md:h-full md:w-auto md:max-w-none">
			<video
				class="locker-video h-full w-full object-cover object-right md:object-contain"
				poster="/hero/locker-closed.webp"
				preload="none"
				muted
				playsinline
				aria-label={videoLabel}
			></video>
		</div>

		<div
			class="pointer-events-none absolute inset-0 z-10 hidden bg-[linear-gradient(to_right,white_0%,white_28%,rgba(255,255,255,0.95)_33%,rgba(255,255,255,0.6)_40%,transparent_48%)] md:block"
		></div>
		<button
			type="button"
			class="absolute right-4 bottom-4 z-30 hidden rounded-md border border-slate-300 bg-white/95 px-3 py-2 text-xs font-medium text-slate-900 shadow-sm backdrop-blur-md hover:bg-white focus-visible:ring-2 focus-visible:ring-slate-900"
			data-close-locker
			disabled
		>
			{closeLabel}
		</button>
	</div>

	<div class="border-t border-slate-200 bg-slate-50">
		<div class="mx-auto max-w-6xl px-4 py-5">
			<div class="grid gap-3 sm:grid-cols-3">
				{compartments.map((compartment, index) => (
					<div
						class="flex min-w-0 items-center gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition data-[state=opened]:border-emerald-300 data-[state=opened]:bg-emerald-50 data-[state=opening]:ring-2 data-[state=opening]:ring-blue-400"
						data-compartment-card
						data-state="idle"
					>
						<div class="min-w-0 flex-1">
							<p class="text-sm font-semibold text-slate-900">{compartment.label}</p>
							<p class="mt-1 truncate text-sm text-slate-600">{compartment.content}</p>
						</div>
						<button
							type="button"
							class:list={[
								'inline-flex shrink-0 items-center justify-center gap-2 rounded-md bg-slate-900 px-3 py-2 text-xs font-medium text-white hover:bg-slate-800 focus-visible:ring-2 focus-visible:ring-slate-900 disabled:cursor-not-allowed disabled:bg-slate-300 data-[state=opened]:disabled:bg-emerald-600 data-[state=opening]:disabled:bg-blue-600',
								{ 'attention-pulse': index === 0 },
							]}
							data-open-compartment
							data-video={compartment.video}
							data-label={compartment.label}
							data-state="idle"
						>
							<span
								class="hidden size-3 animate-spin rounded-full border-2 border-white/40 border-t-white"
								data-loading-indicator
								aria-hidden="true"
							></span>
							<span data-button-label>{openLabel}</span>
						</button>
					</div>
				))}
			</div>

			<div class="mt-3 flex items-center justify-end">
				<p class="text-xs text-slate-600" aria-live="polite" data-locker-status>
					{readyStatus}
				</p>
			</div>
		</div>
	</div>
</div>

<style>
	.attention-pulse {
		animation: attention-pulse 1.6s ease-out infinite;
	}

	@keyframes attention-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgb(37 99 235 / 55%);
		}
		50% {
			box-shadow: 0 0 0 0.55rem rgb(37 99 235 / 0%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.attention-pulse {
			animation: none;
			outline: 3px solid rgb(37 99 235 / 70%);
			outline-offset: 3px;
		}
	}

	@media (min-width: 768px) {
		.locker-video {
			-webkit-mask-image: linear-gradient(to right, transparent 0%, black 20%);
			mask-image: linear-gradient(to right, transparent 0%, black 20%);
		}
	}

	@media (min-width: 768px) and (max-width: 1119px) {
		.locker-video-frame {
			transform: translateX(15%);
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-locker-demo]').forEach((demo) => {
		const video = demo.querySelector<HTMLVideoElement>('video');
		const openButtons = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-open-compartment]'));
		const closeButton = demo.querySelector<HTMLButtonElement>('[data-close-locker]');
		const status = demo.querySelector<HTMLElement>('[data-locker-status]');
		let activeButton: HTMLButtonElement | null = null;

		if (!video || !closeButton || !status) {
			return;
		}

		const reset = () => {
			video.pause();
			video.removeAttribute('src');
			video.load();
			openButtons.forEach((button) => {
				button.disabled = false;
				button.dataset.state = 'idle';
				button.setAttribute('aria-busy', 'false');
				const card = button.closest<HTMLElement>('[data-compartment-card]');
				const indicator = button.querySelector<HTMLElement>('[data-loading-indicator]');
				const label = button.querySelector<HTMLElement>('[data-button-label]');
				card?.setAttribute('data-state', 'idle');
				indicator?.classList.add('hidden');
				if (label) {
					label.textContent = demo.dataset.openLabel ?? '';
				}
			});
			activeButton = null;
			closeButton.disabled = true;
			closeButton.classList.add('hidden');
			closeButton.classList.remove('attention-pulse');
			status.textContent = demo.dataset.readyStatus ?? '';
		};

		openButtons.forEach((button) => {
			button.addEventListener('click', async () => {
				const source = button.dataset.video;
				const label = button.dataset.label ?? '';

				if (!source) {
					return;
				}

				openButtons.forEach((item) => {
					item.classList.remove('attention-pulse');
					item.disabled = true;
				});
				status.textContent = `${demo.dataset.openingStatus ?? ''} ${label}`;
				activeButton = button;
				button.dataset.state = 'opening';
				button.setAttribute('aria-busy', 'true');
				button.closest<HTMLElement>('[data-compartment-card]')?.setAttribute('data-state', 'opening');
				button.querySelector<HTMLElement>('[data-loading-indicator]')?.classList.remove('hidden');
				const buttonLabel = button.querySelector<HTMLElement>('[data-button-label]');
				if (buttonLabel) {
					buttonLabel.textContent = demo.dataset.openingLabel ?? '';
				}
				video.src = source;

				try {
					await video.play();
				} catch {
					reset();
				}
			});
		});

		video.addEventListener('ended', () => {
			status.textContent = demo.dataset.openStatus ?? '';
			closeButton.disabled = false;
			closeButton.classList.remove('hidden');
			closeButton.classList.add('attention-pulse');
			if (activeButton) {
				activeButton.dataset.state = 'opened';
				activeButton.setAttribute('aria-busy', 'false');
				activeButton.closest<HTMLElement>('[data-compartment-card]')?.setAttribute('data-state', 'opened');
				activeButton.querySelector<HTMLElement>('[data-loading-indicator]')?.classList.add('hidden');
				const label = activeButton.querySelector<HTMLElement>('[data-button-label]');
				if (label) {
					label.textContent = demo.dataset.openedLabel ?? '';
				}
			}
		});

		closeButton.addEventListener('click', reset);
	});
</script>
