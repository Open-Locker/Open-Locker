---
type Props = {
	id?: string;
};

const { id = 'architektur' } = Astro.props;
---

<section id={id} class="border-t border-line bg-surface scroll-mt-24">
	<div class="mx-auto max-w-6xl px-4 py-14 md:py-16">
		<div class="space-y-10">
			<div class="space-y-4">
				<div class="space-y-2">
					<h2 class="text-2xl font-semibold tracking-tight text-fg">Aufbau</h2>
					<p class="text-fg-soft">
						Beim Aufbau unseres Projekts haben wir besonders darauf geachtet, alles nutzerfreundlich, aber auch sicher und stabil zu halten.
						Unsere einzelnen Bestandteile sind:
					</p>
				</div>

				<ul class="space-y-3 text-sm text-fg-soft">
					<li>
						<strong class="text-fg">Mobile App (Hauptbedienung)</strong>: eine einfache, nutzerfreundliche App für den Alltag (öffnen, buchen, Status sehen).
					</li>
					<li>
						<strong class="text-fg">Adminbereich</strong>: Verwaltung und Betrieb (Standorte, Geräte, Rollen, Support).
					</li>
					<li>
						<strong class="text-fg">Backend</strong>: prüft Berechtigungen, verwaltet Zustände und stellt die API bereit.
					</li>
					<li>
						<strong class="text-fg">MQTT Broker</strong>: entkoppelt das Backend und Schließfachstandort (Commands ↔ Status).
					</li>
					<li>
						<strong class="text-fg">IoT Client</strong>: läuft z.B. auf einem Raspberry Pi oder ESP und übersetzt Nachrichten in „echte“ Signale zum Schrank (z.B. Modbus).
					</li>
				</ul>
			</div>

			<figure class="rounded-2xl border border-line bg-surface-muted p-6">
				<figcaption class="sr-only">Übersicht: Komponenten und Datenflüsse</figcaption>

				<div class="grid gap-4 lg:grid-cols-4">
					<div class="space-y-2">
						<p class="text-xs font-semibold tracking-wide text-fg-subtle">Benutzer &amp; Admin</p>
						<div class="space-y-2">
							<div class="rounded-xl border border-line bg-surface p-3">
								<p class="text-sm font-semibold text-fg">Endbenutzer</p>
								<p class="mt-0.5 text-xs text-fg-muted">nutzt die App</p>
							</div>
							<div class="rounded-xl border border-line bg-surface p-3">
								<p class="text-sm font-semibold text-fg">Administrator</p>
								<p class="mt-0.5 text-xs text-fg-muted">Admin UI</p>
							</div>
						</div>
					</div>

					<div class="space-y-2">
						<p class="text-xs font-semibold tracking-wide text-fg-subtle">Mobile App</p>
						<div class="rounded-xl border border-line bg-surface p-3">
							<p class="text-sm font-semibold text-fg">Mobile App</p>
							<p class="mt-0.5 text-xs text-fg-muted">Gegenstände buchen &amp; Schließfächer öffnen</p>
						</div>
					</div>

					<div class="space-y-2">
						<p class="text-xs font-semibold tracking-wide text-fg-subtle">Backend (open-locker.de)</p>
						<div class="space-y-2">
							<div class="rounded-xl border border-line bg-surface p-3">
								<p class="text-sm font-semibold text-fg">Laravel Backend</p>
								<p class="mt-0.5 text-xs text-fg-muted">API &amp; Admin Panel</p>
							</div>
							<div class="rounded-xl border border-ok-line bg-ok-surface p-3">
								<p class="text-sm font-semibold text-ok-fg">MQTT Broker</p>
								<p class="mt-0.5 text-xs text-ok-fg/80">Mosquitto</p>
							</div>
							<div class="rounded-xl border border-line bg-surface p-3">
								<p class="text-sm font-semibold text-fg">Datenbank</p>
								<p class="mt-0.5 text-xs text-fg-muted">PostgreSQL / MySQL</p>
							</div>
						</div>
					</div>

					<div class="space-y-2">
						<p class="text-xs font-semibold tracking-wide text-fg-subtle">IoT (Standort)</p>
						<div class="space-y-2">
							<div class="rounded-xl border border-line bg-surface p-3">
								<p class="text-sm font-semibold text-fg">Locker Client</p>
								<p class="mt-0.5 text-xs text-fg-muted">Raspberry Pi / ESP</p>
							</div>
							<div class="rounded-xl border border-line bg-surface p-3">
								<p class="text-sm font-semibold text-fg">Physische Schließfächer</p>
								<p class="mt-0.5 text-xs text-fg-muted">Relais / Schloss</p>
							</div>
							<div class="rounded-xl border border-dashed border-line-strong bg-surface p-3">
								<div class="flex items-center justify-between gap-3">
									<p class="text-sm font-semibold text-fg">QR-Code Scanner</p>
									<span class="rounded-full bg-surface-strong px-2 py-0.5 text-[11px] font-semibold text-fg-soft">Geplant</span>
								</div>
								<p class="mt-0.5 text-xs text-fg-muted">direkt am Schrank</p>
							</div>
						</div>
					</div>
				</div>

				<div class="mt-6 space-y-3">
					<div class="rounded-xl border border-line bg-surface p-4">
						<p class="text-xs font-semibold tracking-wide text-fg-subtle">Command (öffnen, reservieren, …)</p>
						<div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-fg">
							<span class="rounded-full bg-inverse px-2.5 py-1 text-xs font-semibold text-on-inverse">HTTPS (REST)</span>
							<span class="font-medium">App</span>
							<span class="text-slate-400" aria-hidden="true">→</span>
							<span class="font-medium">Backend</span>
							<span class="text-slate-400" aria-hidden="true">→</span>
							<span class="rounded-full bg-ok-surface-strong px-2.5 py-1 text-xs font-semibold text-ok-fg">MQTT</span>
							<span class="font-medium">Broker</span>
							<span class="text-slate-400" aria-hidden="true">→</span>
							<span class="font-medium">Locker Client</span>
							<span class="text-slate-400" aria-hidden="true">→</span>
							<span class="rounded-full bg-surface-strong px-2.5 py-1 text-xs font-semibold text-fg-soft">Modbus</span>
							<span class="font-medium">Schließfach</span>
						</div>
					</div>

					<div class="rounded-xl border border-line bg-surface p-4">
						<p class="text-xs font-semibold tracking-wide text-fg-subtle">Status (Rückmeldung &amp; Live-Updates)</p>
						<div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-fg">
							<span class="font-medium">Schließfach</span>
							<span class="text-slate-400" aria-hidden="true">→</span>
							<span class="font-medium">Locker Client</span>
							<span class="text-slate-400" aria-hidden="true">→</span>
							<span class="rounded-full bg-ok-surface-strong px-2.5 py-1 text-xs font-semibold text-ok-fg">MQTT</span>
							<span class="font-medium">Broker</span>
							<span class="text-slate-400" aria-hidden="true">→</span>
							<span class="font-medium">Backend</span>
							<span class="text-slate-400" aria-hidden="true">→</span>
							<span class="font-medium">Datenbank</span>
							<span class="text-slate-400" aria-hidden="true">·</span>
							<span class="rounded-full bg-inverse px-2.5 py-1 text-xs font-semibold text-on-inverse">Push/SSE</span>
							<span class="font-medium">App</span>
						</div>
					</div>
				</div>
			</figure>
		</div>
	</div>
</section>
