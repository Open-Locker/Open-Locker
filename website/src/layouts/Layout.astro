---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DiscordMeetingInfo from '../components/DiscordMeetingInfo.astro';
import { LINKS } from '../config/links';
import { getLocaleFromUrl, useTranslations, type Locale } from '../i18n';

type Props = {
	lang?: Locale;
};

const { lang = getLocaleFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const iconVersion = '2';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<!-- Inline to avoid a flash of the wrong theme. Same rule as Starlight's ThemeProvider on the docs. -->
		<script is:inline>
			let saved = null;
			try {
				saved = localStorage.getItem('starlight-theme');
			} catch {}
			document.documentElement.dataset.theme =
				saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
		</script>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`/favicon-light.svg?v=${iconVersion}`} media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/svg+xml" href={`/favicon-dark.svg?v=${iconVersion}`} media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href={`/favicon-light.svg?v=${iconVersion}`} />
		<link rel="icon" href={`/favicon.ico?v=${iconVersion}`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<slot name="head" />
	</head>
	<body class="min-h-dvh bg-surface text-fg antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-fg focus:shadow-lg"
		>
			{t.layout.skipToContent}
		</a>

		<SiteHeader />
		<DiscordMeetingInfo variant="banner" discordUrl={LINKS.discordInvite} />

		<main id="main" class="min-h-[60dvh]">
			<slot />
		</main>

		<SiteFooter />
	</body>
</html>
