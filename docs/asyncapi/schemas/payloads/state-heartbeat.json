{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./state-heartbeat.json",
  "title": "Heartbeat state",
  "allOf": [
    {
      "$ref": "../messages/state.json"
    },
    {
      "type": "object",
      "required": [
        "uptime_seconds"
      ],
      "properties": {
        "uptime_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "modbus_connected": {
          "type": "boolean",
          "description": "Whether the Modbus bus is reachable. Absent when the device reports no hardware state; a device can be online and heartbeating while its bus is unreachable."
        }
      }
    }
  ]
}
