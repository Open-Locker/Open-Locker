{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./command-apply-config.json",
  "title": "Apply config command",
  "allOf": [
    {
      "$ref": "../messages/command.json"
    },
    {
      "type": "object",
      "required": [
        "action",
        "data"
      ],
      "properties": {
        "action": {
          "const": "apply_config"
        },
        "data": {
          "type": "object",
          "required": [
            "config_hash",
            "heartbeat_interval_seconds",
            "adapter_type",
            "channel_count",
            "feedback_type",
            "compartments"
          ],
          "properties": {
            "config_hash": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$",
              "description": "SHA-256 of the compact canonical JSON object containing exactly adapter_type, channel_count, feedback_type, and compartments in that key order; compartments are sorted by compartment_number."
            },
            "heartbeat_interval_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "adapter_type": {
              "type": "string",
              "enum": [
                "waveshare_modbus",
                "rs485_lock_board"
              ]
            },
            "channel_count": {
              "type": "integer",
              "enum": [
                8,
                12,
                18,
                24,
                36,
                50
              ]
            },
            "feedback_type": {
              "type": "string",
              "enum": [
                "door_closing",
                "door_opening"
              ]
            },
            "compartments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "compartment_number",
                  "slaveId",
                  "address"
                ],
                "properties": {
                  "compartment_number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "slaveId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "address": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Zero-based channel address; must be less than data.channel_count."
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "adapter_type": {
                    "const": "waveshare_modbus"
                  }
                },
                "required": [
                  "adapter_type"
                ]
              },
              "then": {
                "properties": {
                  "channel_count": {
                    "const": 8
                  }
                }
              }
            }
          ],
          "additionalProperties": true
        }
      }
    }
  ]
}
